APP_ENV=dev
APP_TIMEZONE=America/Sao_Paulo
# Supabase transaction pooler (api/worker) and direct connection (migrations, advisory locks)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL_DIRECT=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_RPS=8
HUBSPOT_SEARCH_RPS=4
STAGE_AGE_DEFAULT_DAYS=14
MIN_N_RANKING=20
MODEL_MIN_CLOSED=300
# M1+ (WhatsApp / LLM) — not used by M0
EVOLUTION_API_URL=                # your self-hosted Evolution API, e.g. https://evolution.example.com (ADR 0008)
EVOLUTION_API_KEY=                 # the server's global AUTHENTICATION_API_KEY — never paste it in chat
EVOLUTION_INSTANCE=                 # set after `omnidata evolution create-instance` + scanning the QR code
EVOLUTION_WEBHOOK_SECRET=          # a random secret you invent (e.g. `openssl rand -hex 32`); no native signature to check instead
LLM_PROVIDER=anthropic            # anthropic | openai | deepseek
OPENAI_API_KEY=                   # also enables voice-note transcription
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_ROUTER=              # only if LLM_PROVIDER=openai (no default on purpose)
OPENAI_MODEL_NARRATOR=
DEEPSEEK_API_KEY=                 # only if LLM_PROVIDER=deepseek; chat only (audio transcription still uses OPENAI_API_KEY)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_ROUTER=            # list the ids your key can use: curl -H "Authorization: Bearer $DEEPSEEK_API_KEY" https://api.deepseek.com/models
DEEPSEEK_MODEL_NARRATOR=
OPENROUTER_API_KEY=               # fallback provider: tried after LLM_PROVIDER if that call errors; alone if LLM_PROVIDER has no key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_ROUTER=          # e.g. deepseek/deepseek-chat — OpenRouter's own catalogue (openrouter.ai/models)
OPENROUTER_MODEL_NARRATOR=
OPENROUTER_SITE_URL=              # optional, sent as HTTP-Referer
OPENROUTER_APP_NAME=              # optional, sent as X-Title
TRANSCRIBE_MODEL=gpt-transcribe   # $0.0045/min; alt: gpt-4o-mini-transcribe ($0.003/min)
TRANSCRIBE_FALLBACK_MODEL=gpt-4o-mini-transcribe
TRANSCRIBE_MAX_SECONDS=180
TRANSCRIBE_DAILY_BUDGET_USD=0.10
CHROMA_URL=                        # Atlas (ADR 0009): semantic index only, never the permission boundary; e.g. http://chroma:8000
CHROMA_COLLECTION=meeting_transcripts
EMBEDDINGS_MODEL=text-embedding-3-small  # OpenAI; reuses OPENAI_API_KEY above
ANTHROPIC_API_KEY=
ALERT_DAILY_CAP=5
ALERT_QUIET_START=20:00
ALERT_QUIET_END=07:00
RATE_LIMIT_MSGS_PER_HOUR=60

# Dataset upload (docs/datasets.md)
ADMIN_API_TOKEN=                  # protects /api/datasets*; empty = uploads disabled
CORS_ORIGINS=                     # e.g. https://omnidata-web-eta.vercel.app (browser access to the upload API)
DATASET_MAX_BYTES=10000000
WEBHOOK_MAX_BYTES=1000000         # bodies above this are rejected before the signature check
DATASET_MAX_ROWS=100000
# Airbyte connector layer (docs/airbyte.md)
INGEST_MODE=direct                # direct | airbyte
AIRBYTE_SCHEMA=airbyte
AIRBYTE_URL=                      # https://api.airbyte.com or your self-managed URL
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
